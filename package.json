{
  "name": "hosted-p2p-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/generate-pages-404.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:e2e",
    "test:e2e": "concurrently -k -s first -n frontend,backend,cypress \"VITE_RELAY_BACKEND_URL=http://localhost:8788 npm run dev -- --host localhost --port 4173 --strictPort\" \"RELAY_ALLOWED_ORIGINS=http://localhost:4173 RELAY_PORT=8788 npm --prefix backend run dev\" \"wait-on http://localhost:4173 http-get://localhost:8788/api/health && env -u ELECTRON_RUN_AS_NODE cypress run --config-file cypress.config.js\"",
    "test:e2e:open": "env -u ELECTRON_RUN_AS_NODE cypress open --config-file cypress.config.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.1",
    "@zip.js/zip.js": "^2.8.23",
    "peerjs": "^1.5.5",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.25",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "cypress": "^14.5.4",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "puppeteer": "^24.8.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "wait-on": "^8.0.5",
    "vue-tsc": "^3.1.5"
  }
}
